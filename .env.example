# Copy to .env.local for local development. Use the publishable key, never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Vercel Marketplace SUPABASE_URL and SUPABASE_ANON_KEY are also supported.
SITE_URL=https://organic-dashboard-psi.vercel.app

# Server-only PostHog read access. Never use a NEXT_PUBLIC_ prefix for this key.
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=452683
POSTHOG_PERSONAL_API_KEY=

# Server-only GSC service-account JSON (never NEXT_PUBLIC). Restricted access to MedicareFAQ.
GSC_SERVICE_ACCOUNT_JSON=

# Ask Charlie: server-only, never NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Active Ask Charlie provider: Anthropic (Claude).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Growth Hunter: enable only after migrations and explicit memberships are verified.
# The database growth_settings.enabled flag must also be enabled by an administrator.
GROWTH_HUNTER_ENABLED=false
